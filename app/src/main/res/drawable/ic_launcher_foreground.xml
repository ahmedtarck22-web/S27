<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mixed Reality Headset Visor -->
    <path
        android:pathData="M 38,30
                         C 30,30 25,34 25,40
                         C 25,48 27,53 31,56
                         C 35,59 41,58 46,55
                         C 48,51 60,51 62,55
                         C 67,58 73,59 77,56
                         C 81,53 83,48 83,40
                         C 83,34 78,30 70,30
                         Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="25"
                android:startY="30"
                android:endX="83"
                android:endY="58"
                android:type="linear">
                <item android:color="#00BCF4" android:offset="0.0" />
                <item android:color="#0078D7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Visor Sensor Pill -->
    <path
        android:pathData="M 48,34
                         h 12
                         a 2.5,2.5 0 0 1 2.5,2.5
                         a 2.5,2.5 0 0 1 -2.5,2.5
                         h -12
                         a 2.5,2.5 0 0 1 -2.5,-2.5
                         a 2.5,2.5 0 0 1 2.5,-2.5
                         Z"
        android:fillColor="#005A9E" />

    <!-- Mixed Reality Smile Arc -->
    <path
        android:pathData="M 36,68 C 42,80 66,80 72,68"
        android:fillColor="#00000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="68"
                android:endX="72"
                android:endY="78"
                android:type="linear">
                <item android:color="#00BCF4" android:offset="0.0" />
                <item android:color="#0078D7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
